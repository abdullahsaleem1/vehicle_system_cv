# Virtual environments
yolo_env/
venv/
env/
.venv/
ENV/

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# IDE & OS temporary files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
.freebuff/

# Ultralytics runtime artifacts & temporary runs
runs/

# ---------------------------------------------------------------------------
# Model weights
# ---------------------------------------------------------------------------
# Only the production `best.pt` checkpoints are tracked, and they go through
# Git LFS (see .gitattributes). Every other weight is ignored because:
#   * Raw `epoch*.pt` checkpoints are 16-23 MB each (~1.1 GB total) and several
#     of them exceed GitHub's hard 100 MB per-file limit.
#   * `last.pt` and per-epoch checkpoints are reproducible from training.
#
# Ignore every weight, then re-allow only the `best.pt` files.
*.pt
*.pth

# Reproducible / oversized training checkpoints
plate_detection/**/weights/*/weights/epoch*.pt
plate_detection/**/weights/*/weights/last.pt
plate_detection/**/weights/*_ft*.pt

# NOTE: the root-level `yolov8n.pt` / `yolo26n.pt` pretrained baselines are
# small (~5-6 MB) and are re-allowed individually below so the repo stays
# runnable out of the box.
!yolov8n.pt
!yolo26n.pt

# Production detector weights (tracked via Git LFS)
!plate_detection/pakistani_finetune/weights/pk_plate_finetune_v2/weights/best.pt
!plate_detection/pakistani_finetune/weights/pk_plate_finetune/weights/best.pt
!plate_detection/weights/plate_detector/weights/best.pt

# ---------------------------------------------------------------------------
# Training datasets (not redistributed in git)
# ---------------------------------------------------------------------------
# Roboflow "license-plate-recognition" v4: ~48k images / ~946 MB. Re-download
# with `python plate_detection/download_dataset.py` - see README "Datasets".
plate_detection/datasets/

# YOLO auto-generated label caches (rebuilt on first training run)
*.cache

# Training logs & PIDs
*.log
*_pid.txt

# ---------------------------------------------------------------------------
# Runtime output artifacts
# ---------------------------------------------------------------------------
# Batch inference outputs are regenerated by ocr_integration/run_anpr_pipeline.py
ocr_integration/outputs*/
ocr_integration/outputs_cars_test/
ocr_integration/*_results.json

# ---------------------------------------------------------------------------
# Model 2 (Tier A) behavior detector - FR-20 (pending supervisor sign-off)
# ---------------------------------------------------------------------------
# Downloaded weights live on local disk and are NOT redistributed via git.
# models/MANIFEST.json IS tracked (it records the verified hash and source);
# the weight binaries themselves are not.
model2_behavior/models/*.pt
model2_behavior/models/*.pth
model2_behavior/models/*.part
!model2_behavior/models/MANIFEST.json

# Per-run logs, annotated videos, event JSON, and effective tracker configs
model2_behavior/logs/
model2_behavior/outputs/
model2_behavior/venv/
outputs/
